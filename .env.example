# Copiar a .env y completar. En docker-compose, MONGODB_URI y REDIS_URL
# ya vienen inyectadas por el environment del servicio web.

# MongoDB (requerido si NO se usa docker-compose)
MONGODB_URI=mongodb://mongo:27017
DB_NAME=TBCPL

# GitHub OAuth App (requerido): crearla en
# Settings > Developer settings > OAuth Apps, callback: https://TU-HOST/api/auth/github/callback
github_oauth_client_id=
github_oauth_client_secret=

# Clave de encriptacion de sesiones: generar con `openssl rand -hex 32`
encryption_key=

# Repo destino de los cambios publicados desde el panel
GITHUB_REPO_OWNER=jacxas
GITHUB_REPO_NAME=NPDHM
GITHUB_REPO_BRANCH=main

# URL publica del sitio (para redirects del OAuth)
SITE_URL=https://jacxas.github.io/NPDHM
